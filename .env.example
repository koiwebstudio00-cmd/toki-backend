# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos (Postgres local de Homebrew) ───────────────────────────────
# Runtime: rol toki_app. `npm run db:migrate:deploy` lo crea con esta password.
DATABASE_URL=postgresql://toki_app:toki_app_dev@localhost:5432/toki
# Migraciones: rol dueño (en la Mac, tu usuario de Homebrew).
DATABASE_URL_MIGRATE=postgresql://dev0@localhost:5432/toki
# Tests: `npm run test:prepare` la recrea desde cero. Tiene que terminar en _test.
DATABASE_URL_TEST=postgresql://dev0@localhost:5432/toki_test

# ── Front ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONT_URL=http://localhost:5173

# ── Seguridad ────────────────────────────────────────────────────────────────
# En producción: openssl rand -hex 32 (en dev puede quedar vacío).
JWT_SECRET=
# SHA-256 de la API key de n8n:  printf '%s' "<key>" | shasum -a 256
AGENT_API_KEY_SHA256=

# ── Motor nativo / chat de prueba (solo servidor; nunca VITE_*) ─────────────
# Conexión directa a OpenAI. Ambos campos habilitan el chat de prueba.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Transcripción de notas de voz antes de enviarlas al modelo de conversación.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Alternativa: Gateway. Para usarla, dejar vacíos OPENAI_API_KEY y OPENAI_MODEL.
AI_GATEWAY_API_KEY=
# ID provider/model elegido del catálogo https://ai-gateway.vercel.sh/v1/models
# Elegir un modelo de texto con llamadas a herramientas; no hay modelo por defecto.
AI_GATEWAY_MODEL=
# Worker persistente. Activar después de configurar el modelo y Zernio.
AGENT_WORKER_ENABLED=false
AGENT_WORKER_CONCURRENCY=4
# Mismo secreto en la suscripción del webhook de Zernio; nunca se expone al panel.
ZERNIO_WEBHOOK_SECRET=

# ── Emails (Resend por SMTP). Sin SMTP_HOST se imprimen en consola ───────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM="Toki <no-reply@localhost>"

# ── Cloudflare R2. Sin credenciales, modo stub ───────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=toki-public-dev
R2_BUCKET_PRIVATE=toki-private-dev
R2_PUBLIC_URL=

# ── Zernio (WhatsApp) ────────────────────────────────────────────────────────
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
