# Variables de producción (Dokploy → toki-api → Environment).
# Copiar, completar y pegar. NUNCA commitear el archivo lleno.
#
# Los tres secretos se generan así:
#   openssl rand -hex 32
# Siempre hex, nunca base64: un "/" rompe la connection string.

NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0

# ── Base de datos ────────────────────────────────────────────────────────────
# Host: el nombre del servicio de Postgres dentro de la red de Dokploy.
# La API corre como toki_app (NOINHERIT, sin privilegios propios).
DATABASE_URL=postgresql://toki_app:<PASSWORD_APP>@toki-db:5432/toki
# Solo para migraciones, en el arranque del contenedor: rol dueño.
DATABASE_URL_MIGRATE=postgresql://toki_owner:<PASSWORD_OWNER>@toki-db:5432/toki
# Conexión dedicada al LISTEN de tiempo real. Vacía = usa DATABASE_URL.
# Conviene dejarla aparte para que el pool nunca se quede sin conexiones.
DATABASE_URL_LISTEN=postgresql://toki_app:<PASSWORD_APP>@toki-db:5432/toki
DB_POOL_MAX=10

# ── Front ────────────────────────────────────────────────────────────────────
# Allowlist separada por comas. SIN barra final.
CORS_ORIGIN=https://toki.koistudio.com.ar
# Base de los links de los emails (verificación y reset).
FRONT_URL=https://toki.koistudio.com.ar

# ── Seguridad ────────────────────────────────────────────────────────────────
# Cambiarlo invalida todas las sesiones activas (los refresh siguen sirviendo).
JWT_SECRET=<openssl rand -hex 32>
# SHA-256 de la API key que usa n8n. La key en claro NO vive en el servidor:
#   KEY=$(openssl rand -hex 32)
#   printf %s "$KEY" | sha256sum | cut -d' ' -f1   # esto va acá
#   echo "$KEY"                                     # esto va en n8n
AGENT_API_KEY_SHA256=<sha256 hex de la key>

# ── Emails (Resend por SMTP) ────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=<API key de Resend>
EMAIL_FROM=Toki <no-reply@koistudio.com.ar>

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# Solo el id (32 caracteres hex), no el endpoint completo. Si pegás
# https://<id>.r2.cloudflarestorage.com igual funciona: la app se queda con el id.
R2_ACCOUNT_ID=<account id de Cloudflare>
R2_ACCESS_KEY_ID=<access key del token de R2>
R2_SECRET_ACCESS_KEY=<secret del token de R2>
R2_BUCKET_PUBLIC=toki-public
R2_BUCKET_PRIVATE=toki-private
# Dominio público del bucket de imágenes: el subdominio r2.dev que te da
# Cloudflare, o un dominio propio si después conectás uno. SIN barra final.
R2_PUBLIC_URL=https://<hash>.r2.dev

# ── Zernio (WhatsApp) ────────────────────────────────────────────────────────
ZERNIO_API_KEY=<api key de Zernio>
ZERNIO_BASE_URL=https://zernio.com/api/v1
